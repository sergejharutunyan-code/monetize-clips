# Copy to .env (or set these in your host's dashboard). Never commit real values.

# ---- Core ----
PORT=8787
# A long random string — signs OAuth state.
CLIPFORGE_SECRET=change-me-to-a-long-random-string
# Where the SQLite file lives (mount a volume here in production).
CLIPFORGE_DB=./data/clipforge.db
# Your frontend origin (for CORS). Use * only for local dev.
CLIPFORGE_ALLOW_ORIGIN=https://sergejharutunyan-code.github.io
# Full app URL to bounce back to after YouTube OAuth.
CLIPFORGE_APP_URL=https://sergejharutunyan-code.github.io/monetize-clips

# ---- Claude (AI workshop) ----
ANTHROPIC_API_KEY=
CLIPFORGE_MODEL=claude-opus-4-8

# ---- YouTube trending (server-side key) ----
YOUTUBE_API_KEY=

# ---- YouTube publishing (your Google OAuth app) ----
# Google Cloud → OAuth consent screen + Credentials → OAuth client (Web).
# Add the redirect URI below to the client's Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-BACKEND-HOST/api/oauth/youtube/callback
