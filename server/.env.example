# Copy to .env (or set these in your host's dashboard). Never commit real values.
# Everything is optional to boot; each block switches one feature on.

# ---- Core ----
PORT=8787
# A long random string — signs OAuth state. (If unset, one is generated and kept in the database.)
CLIPFORGE_SECRET=
# Where the SQLite file lives. Clip videos are stored in a "media" folder next to it.
# Mount a volume here in production.
CLIPFORGE_DB=./data/clipforge.db
# The address this backend is reachable at from the internet. The platforms redirect
# back to it after sign-in, and Instagram downloads clips from it. Render sets this
# automatically; on localhost leave it empty (YouTube sign-in works on localhost,
# Instagram and TikTok need a public https:// address).
CLIPFORGE_PUBLIC_URL=
# Other origins allowed to call the API (comma-separated), e.g. a GitHub Pages copy
# of the app. Use * only for local development.
CLIPFORGE_ALLOW_ORIGIN=*
# Where to send the browser after a platform sign-in if the app did not say.
CLIPFORGE_APP_URL=
# Largest clip upload accepted, in MB.
CLIPFORGE_MAX_UPLOAD_MB=1024

# ---- YouTube publishing ----
# Google Cloud → enable "YouTube Data API v3" → OAuth consent screen → Credentials →
# OAuth client ID (Web application). Authorized redirect URI:
#   <CLIPFORGE_PUBLIC_URL>/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Instagram publishing (Reels) ----
# developers.facebook.com → your app → Instagram → "API setup with Instagram login".
# Use the *Instagram* app ID and secret shown there. OAuth redirect URI:
#   <CLIPFORGE_PUBLIC_URL>/api/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---- TikTok publishing ----
# developers.tiktok.com → your app → add Login Kit + Content Posting API
# (scopes: user.info.basic, video.publish, video.upload). Redirect URI:
#   <CLIPFORGE_PUBLIC_URL>/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# If your app was only granted some scopes, list exactly those:
# TIKTOK_SCOPES=user.info.basic,video.upload

# ---- Claude (AI workshop) ----
ANTHROPIC_API_KEY=
CLIPFORGE_MODEL=claude-opus-4-8

# ---- YouTube trending (server-side key) ----
YOUTUBE_API_KEY=
